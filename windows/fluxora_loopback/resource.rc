#define IDI_FLUXORA_LOOPBACK 101

IDI_FLUXORA_LOOPBACK ICON "../runner/resources/app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Fluxora"
            VALUE "FileDescription", "Fluxora Loopback Manager"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "FluxoraLoopbackManager"
            VALUE "LegalCopyright", "Copyright (C) 2026 Fluxora Contributors. GPL-3.0-or-later."
            VALUE "OriginalFilename", "FluxoraLoopbackManager.exe"
            VALUE "ProductName", "Fluxora Loopback Manager"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
