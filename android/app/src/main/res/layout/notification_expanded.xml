<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded notification layout.

  The stock notification layout shows at most three actions, so the fourth
  (speed test) was silently dropped. A custom big content view is the only way
  to show four; the collapsed state keeps the system layout, which is what makes
  the notification start collapsed and expand on tap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/nf_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:text="" />

    <TextView
        android:id="@+id/nf_speed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="#B3FFFFFF"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <Button
            android:id="@+id/nf_stop"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:textSize="12sp"
            android:textColor="#FF7A7A"
            android:text="停止" />

        <Button
            android:id="@+id/nf_switch"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:textSize="12sp"
            android:textColor="#FFD9D9D9"
            android:text="切换" />

        <Button
            android:id="@+id/nf_reset"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:textSize="12sp"
            android:textColor="#FFD9D9D9"
            android:text="重置" />

        <Button
            android:id="@+id/nf_speed_test"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:textSize="12sp"
            android:textColor="#FFD9D9D9"
            android:text="测速" />
    </LinearLayout>
</LinearLayout>
