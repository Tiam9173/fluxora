<?xml version="1.0" encoding="utf-8"?>
<!-- Fluxora notification icon — light mode
     Derived from fluxora_mark_mono.svg. For Android status bar use:
     foreground must be dark (#0C1222) to contrast against light system bar. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24.0"
    android:viewportHeight="24.0">

    <!-- Upper flow line -->
    <path
        android:pathData="M 3,8 L 8.5,8 C 10.5,8 12.3,9 13.2,10.7 L 15.5,12"
        android:strokeColor="#0C1222"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Lower flow line -->
    <path
        android:pathData="M 3,16 L 8.5,16 C 10.5,16 12.3,15 13.2,13.3 L 15.5,12"
        android:strokeColor="#0C1222"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Convergence node -->
    <path
        android:pathData="M 17.5,12 m -2,0 a 2,2 0 1,0 4,0 a 2,2 0 1,0 -4,0"
        android:fillColor="#0C1222" />

</vector>
